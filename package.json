{
  "name": "api-generator",
  "version": "0.0.1",
  "description": "Technology-independent API generator — generates REST, GraphQL and gRPC APIs for NestJS, Express, Spring Boot, ASP.NET Core, FastAPI and more from a single JSON definition",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "api-generator": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",

    "generate:api": "ts-node scripts/generate-api.ts",
    "generate:api:geminii": "ts-node scripts/geminii-generate.ts",
    "generate:api:run": "ts-node scripts/generate-build-test.ts",
    "generate:swagger": "ts-node scripts/generate-swagger.ts",
    "generate:api-tests": "ts-node scripts/generate-api-tests.ts",

    "generate:nestjs": "ts-node src/cli.ts generate --target=nestjs",
    "generate:express": "ts-node src/cli.ts generate --target=express",
    "generate:springboot": "ts-node src/cli.ts generate --target=springboot",
    "generate:aspnet": "ts-node src/cli.ts generate --target=aspnet",
    "generate:fastapi": "ts-node src/cli.ts generate --target=fastapi",
    "generate:graphql": "ts-node src/cli.ts generate --protocol=graphql",
    "generate:grpc": "ts-node src/cli.ts generate --protocol=grpc",

    "format": "prettier --write .",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.4",
    "@nestjs/core": "^10.3.4",
    "@nestjs/platform-express": "^10.3.4",
    "@nestjs/swagger": "^7.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "openai": "^6.37.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.4",
    "@nestjs/schematics": "^10.0.4",
    "@nestjs/testing": "^10.3.4",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.14.4",
    "@types/supertest": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^2.8.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
